# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# Secreto para firmar JWT
# IMPORTANTE: en produccion debe tener al menos 32 caracteres y NO ser un valor
# por defecto. Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-random-48-byte-hex-secret-with-node-crypto

# URL del frontend para CORS (opcional)
FRONTEND_URL=http://localhost:5173

# URL base de la app para construir enlaces (verificacion, recuperacion, etc.)
APP_URL=http://localhost:5173

# Resend API Key (para envio de correos)
RESEND_API_KEY=your-resend-api-key

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Cloudinary (para subida de imágenes)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
