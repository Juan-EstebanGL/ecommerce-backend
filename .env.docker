# .env.docker
# Variables de entorno para servicios Docker.

# ── PostgreSQL ──
# Deben coincidir con las credenciales del .env del backend.
# El backend actual usa: postgresql://postgres:juanes2710@localhost:5432/ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=juanes2710
POSTGRES_DB=ecommerce_db

# ── Backend (Express) ──
# DATABASE_URL dentro de Docker usa "postgres" como host (nombre del servicio).
# Así el backend se comunica con el contenedor de PostgreSQL vía la red interna.
DATABASE_URL=postgresql://postgres:juanes2710@postgres:5432/ecommerce_db
JWT_SECRET=supersecretkey
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PORT=3000

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=dihmwbxsk
CLOUDINARY_API_KEY=294371188735664
